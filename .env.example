NEXT_PUBLIC_SUPABASE_URL=https://oyloyhzncohnqqwdrpgi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im95bG95aHpuY29obnFxd2RycGdpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY5MDU4NDIsImV4cCI6MjEwMjQ4MTg0Mn0.eh7wa9ywTdK04yG17lTtnnF1XqheVAeBXEj4FRFr2M0

# Лише для серверних роутів/actions, які викликають buy_gpu / harvest_user_hash /
# exchange_hash_to_ton. НІКОЛИ не префіксувати NEXT_PUBLIC_ і не імпортувати
# в код, що потрапляє в браузерний бандл.
# Project Settings → API → service_role secret
# SUPABASE_SERVICE_ROLE_KEY=

# Токен бота від @BotFather — потрібен для HMAC-перевірки Telegram initData
# (lib/telegram/verifyInitData.ts). Тримати лише на сервері.
# TELEGRAM_BOT_TOKEN=

# Юзернейм бота (без @) — публічний, потрібен для побудови реферальних посилань
# https://t.me/<username>?startapp=ref_<telegram_id>
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=CyberGPU_bot

# TODO продакшн-налаштування ПЕРЕД запуском реальних юзерів: посилання/юзернейм
# акаунта підтримки (людина, чат чи бот — SupportButton однаково відкриває його
# через Telegram deep link) — замінити на реальний, зараз плейсхолдер.
NEXT_PUBLIC_SUPPORT_URL=https://t.me/CyberGPU_support

# Публічна адреса TON-гаманця проєкту (treasury), куди йдуть депозити.
# ОБОВ'ЯЗКОВО задати перед тестуванням реальних депозитів — без неї
# DepositModal показує "не налаштовано" замість кнопки поповнення.
NEXT_PUBLIC_TREASURY_TON_ADDRESS=

# Реальний https-домен деплою — потрібен для tonconnect-manifest.json
# (мобільні гаманці фетчать маніфест напряму, відносний шлях не спрацює).
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Опційно: ключ toncenter.com для вищих рейт-лімітів при перевірці депозитів
# (lib/ton/deposit.ts). Без нього працює, але з жорсткими публічними лімітами.
# TONCENTER_API_KEY=

# Список Telegram ID власників, яким дозволено вхід у /admin (через кому,
# без пробілів). Лише вони пройдуть перевірку isTelegramAdmin() — доступ
# видається через криптографічно перевірений Telegram initData, без паролів.
# TELEGRAM_ADMIN_IDS=123456789,987654321

# Секрет для HMAC-підпису сесійної cookie адмінки (окремий від TELEGRAM_BOT_TOKEN
# навмисно). Згенерувати: openssl rand -hex 32
# ADMIN_SESSION_SECRET=

# ⚠️ КРИТИЧНО СЕКРЕТНО: 24-словна mnemonic-фраза гаманця скарбниці
# (той самий, що NEXT_PUBLIC_TREASURY_TON_ADDRESS) — сервер підписує нею
# реальні виплати після Approve в /admin (lib/ton/treasury.ts, налаштовано
# під WalletContractV5R1 / Tonkeeper). Витік = повна втрата коштів
# скарбниці. Вписувати ЛИШЕ напряму у Vercel Dashboard / локальний
# .env.local через IDE — ніколи через чат.
# TREASURY_WALLET_MNEMONIC=

# Захисна межа (TON): суми понад цю НЕ надсилаються автоматично — вимагають
# ручного режиму в адмінці. За замовчуванням 50.
# MAX_AUTO_PAYOUT_TON=50

# Захищає /api/cron/deposits (фоновий воркер автозарахування депозитів,
# vercel.json → crons) від виклику ззовні — Vercel сам додає заголовок
# Authorization: Bearer <це значення> до власних cron-запитів, коли ця змінна
# задана. Згенерувати: openssl rand -hex 32
# CRON_SECRET=
